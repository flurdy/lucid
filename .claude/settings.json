{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd --help)",
      "Bash(bd graph:*)",
      "Bash(bd info:*)",
      "Bash(bd ready:*)",
      "Bash(bd show:*)",
      "Bash(docker search:*)",
      "Bash(docker image ls)",
      "Bash(gh repo view:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Bash(git add -A)"
    ]
  }
}